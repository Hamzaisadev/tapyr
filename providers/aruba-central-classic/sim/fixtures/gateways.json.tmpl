{{- /* GET /monitoring/v1/gateways */ -}}
{{- $gw := items "gateways" -}}
{"count": {{ len $gw }}, "total": {{ len $gw }}, "gateways": [
{{- range $i, $g := $gw }}{{ if $i }},{{ end }}
  {"serial": {{ json (serial $g "XX99999999") }}, "name": "GW-{{ add $g.parent.index 1 }}", "macaddr": {{ json (mac $g) }},
   "model": "A9004", "firmware_version": "10.5.1.0_89234", "ip_address": {{ json (ipv4 $g) }},
   "group_name": "Branch", "site": "Site {{ add $g.parent.index 1 }}", "role": "BGW",
   "status": "{{ flap $g "status" "1h" "Up:0.99" "Down:0.01" }}", "ap_count": 8, "labels": [], "usage": {{ counter $g "usage" 200000 }}}
{{- end }}
]}
