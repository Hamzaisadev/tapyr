# TYPE example_device_clients gauge
example_device_clients{serial="A"} 12.0
# TYPE example_device_info gauge
example_device_info{model="SX \"100\"",serial="A"} 1.0
# HELP example_device_received_bytes Bytes received
# TYPE example_device_received_bytes counter
# UNIT example_device_received_bytes bytes
example_device_received_bytes_total{serial="A"} 1.048576e+06
# TYPE example_device_rssi_dbm gauge
# UNIT example_device_rssi_dbm dbm
example_device_rssi_dbm{serial="A"} -70.0
# HELP example_device_up Device status
# TYPE example_device_up gauge
example_device_up{serial="A"} 1.0
example_device_up{serial="B"} 0.0
example_device_up{serial="C"} 1.0
# EOF
