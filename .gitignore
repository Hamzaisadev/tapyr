# Build output
/bin/
/dist/

# Runtime state
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Test and coverage artifacts
*.test
*.out
/coverage.html

# UI build (embedded at build time, built in CI)
/ui/node_modules/
/ui/dist/app/
/ui/*.tsbuildinfo
/ui/dist/licenses.txt

# Third-party notices, written by make licenses and the release
/THIRD_PARTY_LICENSES

# Integration test output
/test/integration/out/

# Local environment
.env
.env.*
*.local.yaml

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
/tapyr
/tapyr.exe

# Agent instructions are versioned, even when a global ignore excludes them;
# personal agent settings stay local.
!CLAUDE.md
!.claude/
.claude/*
!.claude/skills/
.claude/settings.local.json
CLAUDE.local.md
